---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Navbar.astro';
---

<Layout>
  <Nav activePage="contact" />

  <main>
    <section class="contact-container">
      <h2 class="section-label">CONTACT</h2>
      <h1>Let's connect.</h1>
      
      <p class="contact-description">
        Have a question, want to discuss cybersecurity, or simply want to say hello?
      </p>

      <div class="contact-card">
        <p class="card-label">DIRECT EMAIL</p>
        <a href="mailto:hello@pawanr.com" class="email-link">hello@pawanr.com</a>
        
        <div class="cta-wrapper">
          <a href="mailto:hello@pawanr.com" class="button primary">
            ✉️ Send me an email
          </a>
          <a href="https://www.linkedin.com/in/pawan-r/" target="_blank" rel="noopener noreferrer" class="button secondary">
            LinkedIn Profile ↗
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    box-sizing: border-box;
    min-height: 100vh;
    padding-top: 96px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
  }

  .contact-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 40px;
    width: 100%;
  }

  .section-label {
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.4;
    margin: 0 0 12px;
  }

  h1 {
    font-size: var(--fs-display);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 20px;
  }

  .contact-description {
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 52ch;
  }

  .contact-card {
    border: 1px solid var(--line-strong);
    background: var(--bg-elevated);
    border-radius: 16px;
    padding: 40px;
    text-align: center;
  }

  .card-label {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
  }

  .email-link {
    display: inline-block;
    color: var(--accent);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    font-weight: 700;
    text-decoration: none;
    margin-bottom: 28px;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: var(--accent-hover);
  }

  .cta-wrapper {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 26px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .primary {
    background: var(--accent-strong);
    color: #ffffff;
  }

  .primary:hover {
    background: var(--accent-strong-hover);
    transform: translateY(-2px);
  }

  .secondary {
    border: 1px solid var(--line-strong);
    color: var(--text);
  }

  .secondary:hover {
    border-color: var(--accent);
    color: var(--text);
    transform: translateY(-2px);
  }

  @media (max-width: 359px) {
    main {
      padding-top: 120px;
    }
  }

  @media (max-width: 800px) {
    main {
      padding-top: 80px;
    }

    .contact-container {
      padding: 32px 22px;
    }

    .contact-card {
      padding: 28px 20px;
    }

    .cta-wrapper {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }
</style>

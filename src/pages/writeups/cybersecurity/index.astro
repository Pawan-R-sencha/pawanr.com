
---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import WriteupSidebar from '../../../components/writeups/WriteupSidebar.astro';
---

<Layout
  title="Cybersecurity | Write-ups | Pawan R"
  description="Cybersecurity write-ups covering practical security assessments, experiments, and technical research."
>
  <Navbar activePage="writeups" />

  <main class="writeups-page" id="main-content">
    <WriteupSidebar />

    <section class="writeups-content">
      <div class="breadcrumbs">
        <a href="/writeups/">Write-ups</a>
        <span aria-hidden="true">/</span>
        <span>Cybersecurity</span>
      </div>

      <header class="writeups-header">
        <p class="section-label">WRITE-UP CATEGORY</p>
        <h1>Cybersecurity</h1>
        <p class="intro">
          Practical security assessments, technical experiments, and
          lessons learned through hands-on security research.
        </p>
      </header>

      <section class="writeup-section">
        <p class="category-label">CATEGORIES</p>
        <h2>Explore by topic</h2>

        <a
          class="writeup-card"
          href="/writeups/cybersecurity/network-security/"
        >
          <div class="card-content">
            <h3>Network Security</h3>
            <p>
              Assessments of network services, protocol exposure,
              misconfigurations, and potential attack paths.
            </p>
          </div>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </section>
    </section>
  </main>
</Layout>

<style>
  .writeups-page {
    display: flex;
    min-height: 100vh;
    background: var(--bg);
  }

  .writeups-content {
    flex: 1;
    min-width: 0;
    max-width: 1000px;
    margin: 0 auto;
    padding: 120px 56px;
    font-family: var(--font-serif);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }

  .breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .writeups-header {
    max-width: 760px;
    margin-bottom: 64px;
  }

  .section-label,
  .category-label {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  .section-label {
    margin: 0 0 22px;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-display);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .intro {
    max-width: 56ch;
    margin: 26px 0 0;
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .writeup-section {
    max-width: 850px;
  }

  .category-label {
    margin: 0 0 10px;
  }

  h2 {
    margin: 0 0 22px;
    color: var(--text);
    font-size: var(--fs-h2);
    line-height: 1.3;
  }

  .writeup-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 28px 30px;
    color: inherit;
    text-decoration: none;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color 0.2s ease, background 0.2s ease,
      transform 0.2s ease;
  }

  .writeup-card:hover {
    background: var(--bg-elevated-hover);
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  h3 {
    margin: 0 0 10px;
    color: var(--text);
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .writeup-card p {
    max-width: var(--measure-narrow);
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 1.4rem;
  }

  .writeup-card:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .writeups-content {
      padding: 108px 32px 100px;
    }
  }

  @media (max-width: 600px) {
    .writeups-content {
      padding: 100px 20px 80px;
    }

    .writeup-card {
      padding: 22px;
      gap: 20px;
    }
  }
</style>


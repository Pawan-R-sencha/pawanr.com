---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  current?: string;
  headings?: Heading[];
}

const { current, headings = [] } = Astro.props;

const toc = headings.filter((heading) => heading.depth === 1);

const sections = [
  {
    title: 'CYBERSECURITY',
    groups: [
      {
        title: 'Network Security',
        items: [
          {
            name: 'FTP',
            href: '/writeups/ftp/',
          },
          {
            name: 'NFS',
            href: '/writeups/nfs/',
          },
          {
            name: 'SMTP',
            href: '/writeups/smtp/',
          },
        ],
      },
    ],
  },
];
---

<aside class="writeup-sidebar" id="writeup-sidebar">
  <div class="sidebar-header">
    <span class="sidebar-label">WRITEUPS</span>

    <button
      class="sidebar-collapse"
      id="sidebar-collapse"
      type="button"
      aria-label="Collapse write-up navigation"
      aria-expanded="true"
      aria-controls="writeup-sidebar"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
  </div>

  <nav aria-label="Write-up navigation">
    {sections.map((section) => (
      <div class="section">
        <div class="section-title">{section.title}</div>

        {section.groups.map((group) => (
          <div class="group">
            <div class="group-title">{group.title}</div>

            <div class="items">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class:list={[current === item.name && 'is-active']}
                  aria-current={current === item.name ? 'page' : undefined}
                >{item.name}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}

    {toc.length > 0 && (
      <div class="toc">
        <div class="toc-title">ON THIS PAGE</div>

        <div class="toc-items">
          {toc.map((heading) => (
            <a href={`#${heading.slug}`} data-toc>{heading.text}</a>
          ))}
        </div>
      </div>
    )}
  </nav>
</aside>

<style>
  .writeup-sidebar {
    position: sticky;
    top: 0;
    align-self: flex-start;
    width: 250px;
    flex-shrink: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 32px 20px;
    border-right: 1px solid var(--line);
    box-sizing: border-box;
    font-family: var(--font-sans);
    transition:
      width 0.25s ease,
      padding 0.25s ease,
      opacity 0.2s ease;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 28px;
  }

  .sidebar-label {
    color: var(--accent);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .sidebar-collapse {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    padding: 0;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 6px;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .sidebar-collapse:hover {
    color: var(--text);
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .sidebar-collapse svg {
    transition: transform 0.25s ease;
  }

  .writeup-sidebar.is-collapsed {
    width: 64px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .writeup-sidebar.is-collapsed .sidebar-header {
    justify-content: center;
  }

  .writeup-sidebar.is-collapsed .sidebar-label,
  .writeup-sidebar.is-collapsed nav {
    display: none;
  }

  .writeup-sidebar.is-collapsed .sidebar-collapse svg {
    transform: rotate(180deg);
  }

  .section {
    margin-bottom: 28px;
  }

  .section-title {
    margin-bottom: 16px;
    color: var(--text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .group {
    margin-bottom: 16px;
  }

  .group-title {
    margin-bottom: 8px;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 12px;
    border-left: 1px solid var(--line);
  }

  .items a {
    padding: 6px 10px;
    color: var(--text-muted);
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 4px;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .items a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .items a.is-active {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  .toc {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .toc-title {
    margin-bottom: 10px;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .toc-items {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .toc-items a {
    display: block;
    padding: 5px 0 5px 10px;
    border-left: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.45;
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .toc-items a:hover {
    color: var(--text-secondary);
    border-left-color: var(--accent);
  }

  .toc-items a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  @media (max-width: 900px) {
    .sidebar-collapse {
      display: none;
    }

    .writeup-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 40;
      width: 290px;
      height: 100vh;
      overflow-y: auto;
      padding: 88px 24px 32px;
      background: var(--bg);
      border-right: 1px solid var(--line);
      box-shadow: 12px 0 40px rgba(0, 0, 0, 0.4);
      transform: translateX(-100%);
      transition: transform 0.25s ease;
    }

    .writeup-sidebar.is-open {
      transform: translateX(0);
    }

    .writeup-sidebar.is-collapsed {
      width: 290px;
      padding: 88px 24px 32px;
    }

    .writeup-sidebar.is-collapsed .sidebar-label {
      display: inline;
    }

    .writeup-sidebar.is-collapsed nav {
      display: block;
    }
  }
</style>

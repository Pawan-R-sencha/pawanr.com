---
interface Props {
  activePage?: 'home' | 'journey' | 'writeups' | 'contact';
  flow?: 'absolute' | 'static';
}

const { activePage, flow = 'absolute' } = Astro.props;
---

<nav class:list={['navbar', flow === 'static' && 'navbar-static']} aria-label="Main Navigation">
  <div class="nav-container">
    <a href="/" class="logo">Pawan R</a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <div class="nav-links" id="nav-menu">
      <a href="/" class:list={['nav-home', activePage === 'home' && 'active']}>Pawan R</a>
      <a href="/journey/" class={activePage === 'journey' ? 'active' : ''}>My Journey</a>
      <a href="/writeups/" class={activePage === 'writeups' ? 'active' : ''}>Write-ups</a>
      <a href="/contact/" class={activePage === 'contact' ? 'active' : ''}>Contact</a>
    </div>
  </div>
</nav>

<script is:inline src="/js/navbar.js"></script>

<style>
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    pointer-events: none;
  }

  .navbar a,
  .navbar button,
  .nav-links {
    pointer-events: auto;
  }

  .navbar-static {
    position: static;
  }

  .nav-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 25px 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 44px;
  }

  .navbar-static .nav-container {
    padding-top: 30px;
    padding-bottom: 0;
  }

  .logo {
    color: #aebdcc;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .logo:hover {
    color: #4da6ff;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav-toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    margin: 0 auto;
    background: #aebdcc;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-links a {
    color: #aebdcc;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #4da6ff;
  }

  .nav-home {
    display: none;
  }

  @media (max-width: 800px) {
    .nav-container {
      padding: 20px;
      gap: 12px;
    }

    .navbar-static .nav-container {
      padding-top: 24px;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      right: 20px;
      flex-direction: column;
      gap: 0;
      min-width: 180px;
      padding: 8px 0;
      background: #0d1b2e;
      border: 1px solid #1e2f45;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 18px;
      font-size: 0.95rem;
    }

    .nav-home {
      display: block;
    }
  }
</style>

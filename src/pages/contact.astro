---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Navbar.astro';
---

<Layout>
  <Nav activePage="contact" />

  <main>
    <section class="contact-container">
      <p class="section-label">CONTACT</p>
      <h1>Let's connect.</h1>
      
      <p class="contact-description">
        Have a question, want to discuss cybersecurity, or simply want to say hello?
      </p>

      <div class="contact-card">
        <p class="card-label">DIRECT EMAIL</p>
        <a href="mailto:hello@pawanr.com" class="email-link">hello@pawanr.com</a>
        
        <div class="cta-wrapper">
          <a href="mailto:hello@pawanr.com" class="button primary">
            ✉️ Send me an email
          </a>
          <a href="https://www.linkedin.com/in/pawan-r/" target="_blank" rel="noopener noreferrer" class="button secondary">
            LinkedIn Profile ↗
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    min-height: 85vh;
    background: #07111f;
    color: #f5f7fa;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    display: flex;
    align-items: center;
  }

  .contact-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 60px 40px;
    width: 100%;
  }

  .section-label {
    color: #708399;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    margin: 0 0 20px;
  }

  .contact-description {
    color: #aebdcc;
    font-size: 1.15rem;
    line-height: 1.7;
    margin: 0 0 40px;
  }

  .contact-card {
    border: 1px solid #1d3249;
    background: #0b1929;
    border-radius: 16px;
    padding: 40px;
    text-align: center;
    box-shadow: 0 0 50px rgba(22, 131, 255, 0.08);
  }

  .card-label {
    color: #708399;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 12px;
  }

  .email-link {
    display: inline-block;
    color: #4da6ff;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    text-decoration: none;
    margin-bottom: 30px;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: #60a5fa;
  }

  .cta-wrapper {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  .button {
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .primary {
    background: #1683ff;
    color: white;
  }

  .primary:hover {
    background: #006ce6;
    transform: translateY(-2px);
  }

  .secondary {
    border: 1px solid #31445b;
    color: #dce7f2;
  }

  .secondary:hover {
    border-color: #4da6ff;
    color: #ffffff;
    transform: translateY(-2px);
  }

  @media (max-width: 800px) {
    .contact-container {
      padding: 40px 24px;
    }

    .contact-card {
      padding: 28px 20px;
    }

    .cta-wrapper {
      flex-direction: column;
    }

    .button {
      text-align: center;
    }
  }
</style>
---

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import WriteupSidebar from '../components/writeups/WriteupSidebar.astro';
-------------------------------------------------------------------------

<Layout>
  <Navbar activePage="writeups" />

  <main class="writeups-page">
    <WriteupSidebar />

```
<section class="writeups-content">
  <div class="writeups-header">
    <p class="section-label">WRITEUPS</p>

    <h1>
      Security research,<br />
      <span>documented.</span>
    </h1>

    <p class="intro">
      A collection of practical security assessments, experiments,
      and technical write-ups documenting what I learn along the way.
    </p>
  </div>

  <section class="writeup-section">
    <p class="category-label">CYBERSECURITY</p>

    <h2>Network Security</h2>

    <a
      class="writeup-card"
      href="/writeups/ftp/"
    >
      <div class="card-content">
        <p class="protocol">FTP</p>

        <h3>FTP: From Misconfiguration to Compromise</h3>

        <p>
          A systematic security assessment covering anonymous access,
          file operation abuse, FTP-to-Apache exposure, PHP execution,
          reverse shell access, and credential discovery.
        </p>
      </div>

      <span class="arrow">→</span>
    </a>
  </section>
</section>
```

  </main>
</Layout>

<style>
  .writeups-page {
    display: flex;
    min-height: calc(100vh - 80px);
    background: #080b10;
  }

  .writeups-content {
    flex: 1;
    min-width: 0;
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 56px 120px;
  }

  .writeups-header {
    max-width: 760px;
    margin-bottom: 80px;
  }

  .section-label,
  .category-label,
  .protocol {
    color: #5b9cff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .section-label {
    margin: 0 0 24px;
  }

  h1 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  h1 span {
    color: #5b9cff;
  }

  .intro {
    max-width: 680px;
    margin: 32px 0 0;
    color: #aeb8c7;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .writeup-section {
    max-width: 850px;
  }

  .category-label {
    margin: 0 0 12px;
  }

  h2 {
    margin: 0 0 24px;
    color: #ffffff;
    font-size: 1.6rem;
  }

  .writeup-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 28px 30px;
    color: inherit;
    text-decoration: none;
    background: #0c1016;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .writeup-card:hover {
    background: #10151d;
    border-color: rgba(91, 156, 255, 0.35);
    transform: translateY(-2px);
  }

  .card-content {
    min-width: 0;
  }

  .protocol {
    margin: 0 0 12px;
  }

  h3 {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .writeup-card p:not(.protocol) {
    margin: 0;
    max-width: 720px;
    color: #8d98a8;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .arrow {
    flex-shrink: 0;
    color: #5b9cff;
    font-size: 1.4rem;
    transition: transform 0.2s ease;
  }

  .writeup-card:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .writeups-content {
      padding: 64px 32px 100px;
    }
  }

  @media (max-width: 600px) {
    .writeups-content {
      padding: 48px 20px 80px;
    }

    .writeup-card {
      padding: 22px;
    }

    .writeup-card p:not(.protocol) {
      font-size: 0.88rem;
    }
  }
</style>

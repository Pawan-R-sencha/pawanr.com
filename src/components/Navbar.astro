---
interface Props {
  activePage?: 'home' | 'journey' | 'writeups' | 'contact';
  flow?: 'absolute' | 'static';
}

const { activePage, flow = 'absolute' } = Astro.props;

const links = [
  { page: 'journey' as const, href: '/journey/', label: 'My Journey' },
  { page: 'writeups' as const, href: '/writeups/', label: 'Write-ups' },
  { page: 'contact' as const, href: '/contact/', label: 'Contact' },
];
---

<nav class:list={['navbar', flow === 'static' && 'navbar-static']} aria-label="Main Navigation">
  <div class="nav-container">
    <a
      href="/"
      class:list={['logo', activePage === 'home' && 'is-current']}
      aria-current={activePage === 'home' ? 'page' : undefined}
    >Pawan R</a>

    <div class="nav-links">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[activePage === link.page && 'active']}
          aria-current={activePage === link.page ? 'page' : undefined}
        >{link.label}</a>
      ))}

      <details class="theme-menu" id="theme-menu">
        <summary class="theme-toggle" aria-label="Color theme: system">
          <span class="theme-icon theme-icon-system" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="12" rx="2"></rect>
              <path d="M8 20h8M12 16v4"></path>
            </svg>
          </span>
          <span class="theme-icon theme-icon-light" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
          </span>
          <span class="theme-icon theme-icon-dark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </span>
        </summary>

        <div class="theme-options" role="group" aria-label="Color theme">
          <button type="button" data-theme-choice="system" aria-pressed="false">System</button>
          <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
          <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
        </div>
      </details>
    </div>
  </div>
</nav>



<style>
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    font-family: var(--font-sans);
    pointer-events: none;
  }

  .navbar a,
  .nav-links {
    pointer-events: auto;
  }

  .navbar-static {
    position: static;
  }

  .nav-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px 40px;
  }

  .navbar-static .nav-container {
    padding-top: 22px;
    padding-bottom: 0;
  }

  .logo,
  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .logo {
    font-size: 0.9rem;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 4px 26px;
  }

  .nav-links a {
    font-size: 0.9rem;
  }

  .logo:hover,
  .nav-links a:hover {
    color: var(--accent);
  }

  .nav-links a.active,
  .logo.is-current {
    color: var(--accent);
  }

  .nav-links a.active::after,
  .logo.is-current::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  /* Theme control */
  .theme-menu {
    position: relative;
    display: inline-flex;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 10px;
    list-style: none;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .theme-toggle::-webkit-details-marker {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .theme-menu[open] .theme-toggle {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .theme-options {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 152px;
    padding: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .theme-options button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding: 0 10px 0 12px;
    color: var(--text-secondary);
    background: transparent;
    border: 0;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
  }

  .theme-options button:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .theme-options button[aria-pressed="true"] {
    color: var(--accent);
    font-weight: 600;
  }

  .theme-options button[aria-pressed="true"]::after {
    content: "✓";
    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .nav-container {
      padding: 16px 24px;
      justify-content: center;
      gap: 2px 18px;
    }

    .navbar-static .nav-container {
      padding-top: 16px;
    }

    .logo,
    .nav-links a {
      font-size: 0.86rem;
    }

    .nav-links {
      gap: 2px 18px;
    }
  }

  @media (max-width: 420px) {
    .nav-container {
      padding: 12px 16px;
      gap: 0 12px;
    }

    .logo,
    .nav-links a {
      min-height: 44px;
      font-size: 0.82rem;
    }

    .nav-links {
      gap: 0 12px;
    }
  }
</style>

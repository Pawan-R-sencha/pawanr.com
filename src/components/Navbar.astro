---
interface Props {
  activePage?: 'home' | 'journey' | 'writeups' | 'contact';
  flow?: 'absolute' | 'static';
}

const { activePage, flow = 'absolute' } = Astro.props;
---

<nav class:list={['navbar', flow === 'static' && 'navbar-static']} aria-label="Main Navigation">
  <div class="nav-container">
    <a href="/" class="logo">Pawan R</a>

    <div class="nav-links">
      <a href="/journey/" class={activePage === 'journey' ? 'active' : ''}>My Journey</a>
      <a href="/writeups/" class={activePage === 'writeups' ? 'active' : ''}>Write-ups</a>
      <a href="/contact/" class={activePage === 'contact' ? 'active' : ''}>Contact</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    pointer-events: none;
  }

  .navbar a,
  .nav-links {
    pointer-events: auto;
  }

  .navbar-static {
    position: static;
  }

  .nav-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 25px 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px 44px;
  }

  .navbar-static .nav-container {
    padding-top: 30px;
    padding-bottom: 0;
  }

  .logo {
    color: #aebdcc;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .logo:hover {
    color: #4da6ff;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 28px;
  }

  .nav-links a {
    color: #aebdcc;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #4da6ff;
  }

  @media (max-width: 800px) {
    .nav-container {
      padding: 20px;
      gap: 8px 16px;
    }

    .navbar-static .nav-container {
      padding-top: 24px;
    }

    .logo {
      font-size: 0.82rem;
    }

    .nav-links {
      gap: 8px 16px;
    }

    .nav-links a {
      font-size: 0.78rem;
    }
  }

  @media (max-width: 420px) {
    .nav-container {
      padding: 18px 16px;
      gap: 6px 12px;
    }

    .logo {
      font-size: 0.76rem;
    }

    .nav-links {
      gap: 6px 12px;
    }

    .nav-links a {
      font-size: 0.72rem;
    }
  }
</style>


---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import WriteupSidebar from '../components/writeups/WriteupSidebar.astro';
---

<Layout
  title="Write-ups | Pawan R"
  description="Explore practical cybersecurity write-ups, technical assessments, experiments, and perspectives documenting what I learn along the way."
>
  <Navbar activePage="writeups" />

  <main class="writeups-page" id="main-content">
    <WriteupSidebar />

    <section class="writeups-content">
      <header class="writeups-header">
        <p class="section-label">THE LIBRARY</p>

        <h1>
          Research,<br />
          <span>documented.</span>
        </h1>

        <p class="intro">
          A growing collection of hands-on security research, technical
          write-ups, experiments, and ideas. Each entry documents what I
          explore, what I learn, and how I approach the problem.
        </p>
      </header>

      <section class="writeup-section">
        <p class="category-label">EXPLORE</p>

        <h2>Browse the library</h2>

        <a
          class="writeup-card"
          href="/writeups/cybersecurity/"
        >
          <div class="card-content">
            <p class="protocol">01 / TECHNICAL RESEARCH</p>

            <h3>Cybersecurity</h3>

            <p>
              Practical security assessments, network-service testing,
              web and API security, cloud reviews, and technical
              experiments — documented with methodology, findings,
              and lessons learned.
            </p>

            <span class="card-meta">Network Security · More topics to come</span>
          </div>

          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <article class="writeup-card planned-card">
          <div class="card-content">
            <p class="protocol">02 / IDEAS &amp; REFLECTIONS</p>

            <h3>Perspectives</h3>

            <p>
              Essays, opinions, lessons, and ideas beyond technical
              write-ups — covering technology, learning, building,
              and topics worth thinking about.
            </p>

            <span class="card-meta">Coming later</span>
          </div>

          <span class="status" aria-label="Coming later">Planned</span>
        </article>
      </section>
    </section>
  </main>
</Layout>

<style>
  .writeups-page {
    display: flex;
    min-height: 100vh;
    background: var(--bg);
  }

  .writeups-content {
    flex: 1;
    min-width: 0;
    max-width: 1000px;
    margin: 0 auto;
    padding: 120px 56px 120px;
    font-family: var(--font-serif);
  }

  .writeups-header {
    max-width: 760px;
    margin-bottom: 72px;
  }

  .section-label,
  .category-label,
  .protocol {
    font-family: var(--font-sans);
    color: var(--accent);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  .section-label {
    margin: 0 0 22px;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-display);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  h1 span {
    color: var(--accent);
  }

  .intro {
    max-width: 56ch;
    margin: 26px 0 0;
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .writeup-section {
    max-width: 850px;
  }

  .category-label {
    margin: 0 0 10px;
  }

  h2 {
    margin: 0 0 22px;
    color: var(--text);
    font-size: var(--fs-h2);
    line-height: 1.3;
  }

  .writeup-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 28px 30px;
    margin-bottom: 14px;
    color: inherit;
    text-decoration: none;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  a.writeup-card:hover {
    background: var(--bg-elevated-hover);
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  .card-content {
    min-width: 0;
  }

  .protocol {
    margin: 0 0 10px;
  }

  h3 {
    margin: 0 0 10px;
    color: var(--text);
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .writeup-card p:not(.protocol) {
    margin: 0;
    max-width: var(--measure-narrow);
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
  }

  .card-meta {
    display: block;
    margin-top: 18px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 1.4rem;
    transition: transform 0.2s ease;
  }

  .writeup-card:hover .arrow {
    transform: translateX(4px);
  }

  .planned-card {
    opacity: 0.82;
    cursor: default;
  }

  .status {
    flex-shrink: 0;
    padding: 6px 10px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.4;
    border: 1px solid var(--line);
    border-radius: 5px;
  }

  @media (max-width: 900px) {
    .writeups-content {
      padding: 108px 32px 100px;
    }
  }

  @media (max-width: 359px) {
    .writeups-content {
      padding-top: 128px;
    }
  }

  @media (max-width: 600px) {
    .writeups-content {
      padding: 100px 20px 80px;
    }

    .writeup-card {
      padding: 22px;
      gap: 20px;
    }

    .writeup-card p:not(.protocol) {
      font-size: 0.95rem;
    }

    .status {
      font-size: 0.7rem;
    }
  }
</style>

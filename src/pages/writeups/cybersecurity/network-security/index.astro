
---
import Layout from '../../../../layouts/Layout.astro';
import Navbar from '../../../../components/Navbar.astro';
import WriteupSidebar from '../../../../components/writeups/WriteupSidebar.astro';
---

<Layout
  title="Network Security | Cybersecurity Write-ups | Pawan R"
  description="Practical network security assessments covering service enumeration, protocol misconfigurations, exposed access, and attack paths."
>
  <Navbar activePage="writeups" />

  <main class="writeups-page" id="main-content">
    <WriteupSidebar />

    <section class="writeups-content">
      <div class="breadcrumbs">
        <a href="/writeups/">Write-ups</a>
        <span aria-hidden="true">/</span>
        <a href="/writeups/cybersecurity/">Cybersecurity</a>
        <span aria-hidden="true">/</span>
        <span>Network Security</span>
      </div>

      <header class="writeups-header">
        <p class="section-label">CYBERSECURITY / NETWORK SECURITY</p>

        <h1>
          Network security,<br />
          <span>documented.</span>
        </h1>

        <p class="intro">
          Hands-on assessments of network services and protocols, exploring
          exposed functionality, security misconfigurations, attack paths,
          and practical lessons learned through testing.
        </p>
      </header>

      <section class="writeup-section">
        <p class="category-label">NETWORK SECURITY</p>

        <h2>Technical write-ups</h2>

        <a
          class="writeup-card"
          href="/writeups/cybersecurity/network-security/ftp/"
        >
          <div class="card-content">
            <p class="protocol">FTP</p>

            <h3>FTP: From Misconfiguration to Compromise</h3>

            <p>
              A systematic security assessment covering anonymous access,
              file operation abuse, FTP-to-Apache exposure, PHP execution,
              reverse shell access, and credential discovery.
            </p>
          </div>

          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <a
          class="writeup-card"
          href="/writeups/cybersecurity/network-security/nfs/"
        >
          <div class="card-content">
            <p class="protocol">NFS</p>

            <h3>NFS: From Misconfiguration to SSH Access</h3>

            <p>
              A systematic security assessment covering NFS export
              enumeration, writable home directory exposure, SSH
              authentication material, and authenticated SSH access.
            </p>
          </div>

          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <a
          class="writeup-card"
          href="/writeups/cybersecurity/network-security/smtp/"
        >
          <div class="card-content">
            <p class="protocol">SMTP</p>

            <h3>OpenSMTPD: From SMTP Exposure to Remote Code Execution</h3>

            <p>
              A systematic security assessment covering SMTP version
              disclosure, recipient enumeration, CVE-2020-7247 validation,
              remote command execution, and privileged shell access.
            </p>
          </div>

          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </section>
    </section>
  </main>
</Layout>

<style>
  .writeups-page {
    display: flex;
    min-height: 100vh;
    background: var(--bg);
  }

  .writeups-content {
    flex: 1;
    min-width: 0;
    max-width: 1000px;
    margin: 0 auto;
    padding: 120px 56px 120px;
    font-family: var(--font-serif);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 32px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .breadcrumbs span:last-child {
    color: var(--text);
  }

  .writeups-header {
    max-width: 760px;
    margin-bottom: 72px;
  }

  .section-label,
  .category-label,
  .protocol {
    font-family: var(--font-sans);
    color: var(--accent);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  .section-label {
    margin: 0 0 22px;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-display);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  h1 span {
    color: var(--accent);
  }

  .intro {
    max-width: 56ch;
    margin: 26px 0 0;
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .writeup-section {
    max-width: 850px;
  }

  .category-label {
    margin: 0 0 10px;
  }

  h2 {
    margin: 0 0 22px;
    color: var(--text);
    font-size: var(--fs-h2);
    line-height: 1.3;
  }

  .writeup-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 28px 30px;
    margin-bottom: 14px;
    color: inherit;
    text-decoration: none;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .writeup-card:hover {
    background: var(--bg-elevated-hover);
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  .card-content {
    min-width: 0;
  }

  .protocol {
    margin: 0 0 10px;
  }

  h3 {
    margin: 0 0 10px;
    color: var(--text);
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .writeup-card p:not(.protocol) {
    margin: 0;
    max-width: var(--measure-narrow);
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 1.4rem;
    transition: transform 0.2s ease;
  }

  .writeup-card:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .writeups-content {
      padding: 108px 32px 100px;
    }
  }

  @media (max-width: 359px) {
    .writeups-content {
      padding-top: 128px;
    }
  }

  @media (max-width: 600px) {
    .writeups-content {
      padding: 100px 20px 80px;
    }

    .breadcrumbs {
      gap: 7px;
      font-size: 0.8rem;
    }

    .writeup-card {
      padding: 22px;
      gap: 20px;
    }

    .writeup-card p:not(.protocol) {
      font-size: 0.95rem;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <nav class="navbar" aria-label="Main Navigation">
    <div class="nav-links">
      <a href="/journey/">My Journey</a>
      <a href="/writeups/">Write-ups</a>
      <a href="/contact/">Contact</a>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="greeting">Namaste <span>🙏</span></p>

        <h1>
          <span class="headline-first">Offensive Security |</span>
          Curious Mind
          <span class="tagline">Learning, Building, Explaining How Things Work</span>
        </h1>

        <p class="hero-description">
          I'm Pawan R — a cybersecurity graduate who's more curious
          about the <strong>"why"</strong> behind an attack path
          than just finding it.
        </p>

        <p class="hero-description">
          I work across web applications, APIs, networks, and cloud
          environments, while continuing to deepen my skills in
          offensive security.
        </p>

        <div class="hero-buttons">
          <a href="/journey/" class="button primary">My Journey</a>
          <a href="/writeups/" class="button secondary">View Write-ups</a>
        </div>
      </div>

      <div class="hero-photo">
        <div class="photo-frame">
          <img
            src="/images/pawan-photo.png"
            alt="Pawan R - Offensive Security Professional"
          />
        </div>
      </div>
    </section>

    <section class="focus">
      <p class="section-label">WHAT I WORK WITH</p>

      <div class="focus-grid">
        <div>Web Application Security</div>
        <div>API Security</div>
        <div>Network Security</div>
        <div>Cloud Security Assessment (AWS/GCP)</div>
        <div>Vulnerability Assessment & Penetration Testing</div>
        <div>Phishing / Social Engineering</div>
        <div>Security Automation</div>
      </div>
    </section>

    <section class="highlights">
      <p class="section-label">MILESTONES & CERTIFICATIONS</p>

      <div class="highlight-pills">
        <span class="pill gold-accent">🏆 B.Sc. Cyber Security Gold Medalist Graduate</span>
        <span class="pill award-accent">⭐ Best Newbie Award</span>
        <span class="pill">TryHackMe Top 2%</span>
        <span class="pill">eJPT</span>
        <span class="pill">eWPT</span>
        <span class="pill">ICCA</span>
      </div>
    </section>

    <section class="split-row">
      <div class="split-card">
        <p class="section-label">CURRENTLY LEARNING</p>
        <p class="split-text">
          Active Directory & Windows Security, and going deeper
          into offensive security fundamentals.
        </p>
      </div>

      <div class="split-card">
        <p class="section-label">MENTORING</p>
        <p class="split-text">
          I train and mentor aspiring security professionals
          from the ground up.
        </p>
      </div>
    </section>

    <section class="closing-cta">
      <p>Want the full story — certifications, my graduation, and how I got here?</p>
      <a href="/journey/" class="button primary">Read My Journey</a>
    </section>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    background: #07111f;
    color: #f5f7fa;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .navbar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 40px 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-links a {
    color: #aebdcc;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #f5f7fa;
  }

  .hero {
    max-width: 1200px;
    min-height: 72vh;
    margin: 0 auto;
    padding: 60px 40px;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: 70px;
  }

  .greeting {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #60a5fa;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 24px;
    background: rgba(77, 166, 255, 0.08);
    border: 1px solid rgba(77, 166, 255, 0.2);
    padding: 8px 18px;
    border-radius: 999px;
    width: fit-content;
    box-shadow: 0 0 20px rgba(77, 166, 255, 0.1);
  }

  .greeting span {
    display: inline-block;
    font-size: 1.6rem;
    transition: transform 0.2s ease;
  }

  .greeting:hover span {
    transform: scale(1.2) rotate(5deg);
  }

  h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0 0 30px;
    max-width: 800px;
  }

  .headline-first {
    white-space: nowrap;
    display: inline-block;
    color: #4da6ff;
    margin-right: 0.15em;
  }

  h1 .tagline {
    display: block;
    color: #aebdcc;
    font-size: 0.3em;
    font-weight: 500;
    letter-spacing: 0;
    margin-top: 18px;
    max-width: 620px;
  }

  .hero-description {
    max-width: 700px;
    color: #aebdcc;
    font-size: 1.1rem;
    line-height: 1.8;
    margin: 0 0 15px;
  }

  .hero-description strong {
    color: #f5f7fa;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 35px;
  }

  .button {
    padding: 13px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .primary {
    background: #1683ff;
    color: white;
  }

  .primary:hover {
    background: #006ce6;
  }

  .secondary {
    border: 1px solid #31445b;
    color: #dce7f2;
  }

  .secondary:hover {
    border-color: #4da6ff;
    color: #ffffff;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .hero-photo {
    display: flex;
    justify-content: center;
  }

  .photo-frame {
    width: min(360px, 100%);
    border: 1px solid #25415e;
    border-radius: 18px;
    padding: 10px;
    background: #0c1b2c;
    box-shadow: 0 0 60px rgba(22, 131, 255, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .photo-frame:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 70px rgba(22, 131, 255, 0.22);
  }

  .photo-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 12px;
  }

  .focus,
  .highlights,
  .split-row,
  .closing-cta {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 40px;
  }

  .section-label {
    color: #708399;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .focus-grid div {
    border: 1px solid #1d3249;
    background: #0b1929;
    border-radius: 10px;
    padding: 20px;
    color: #c8d5e3;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .focus-grid div:hover {
    transform: translateY(-3px);
    border-color: #315275;
    color: #ffffff;
  }

  .highlight-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    border: 1px solid #25415e;
    background: #0c1b2c;
    color: #dce7f2;
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  .pill:hover {
    transform: translateY(-2px);
  }

  .pill.gold-accent {
    border-color: #d4af37;
    background: rgba(212, 175, 55, 0.12);
    color: #fce89e;
  }

  .pill.award-accent {
    border-color: #4da6ff;
    background: rgba(77, 166, 255, 0.12);
    color: #b3d9ff;
  }

  .split-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .split-card {
    border: 1px solid #1d3249;
    background: #0b1929;
    border-radius: 12px;
    padding: 24px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .split-card:hover {
    transform: translateY(-3px);
    border-color: #315275;
  }

  .split-text {
    color: #c8d5e3;
    line-height: 1.7;
    margin: 0;
  }

  .closing-cta {
    text-align: center;
    padding: 60px 40px 100px;
  }

  .closing-cta p {
    color: #aebdcc;
    font-size: 1.15rem;
    margin: 0 0 24px;
  }

  @media (max-width: 800px) {
    .navbar {
      padding: 24px 24px 0;
    }

    .hero {
      grid-template-columns: 1fr;
      padding-top: 40px;
      gap: 40px;
    }

    .hero-photo {
      order: -1;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    .split-row {
      grid-template-columns: 1fr;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .button {
      text-align: center;
    }
  }
</style>
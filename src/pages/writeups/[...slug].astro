
---
import { getCollection, render } from 'astro:content';
import WriteupLayout from '../../components/writeups/WriteupLayout.astro';
import { getWriteupNeighbors, getWriteupUrl } from '../../lib/writeups';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');

  return writeups
    .filter((writeup) => !writeup.data.draft)
    .map((writeup) => {
      const url = getWriteupUrl(writeup);
      const slug = url
        .replace(/^\/writeups\//, '')
        .replace(/\/$/, '');

      return {
        params: { slug },
        props: { writeup },
      };
    });
}

const { writeup } = Astro.props;
const { Content, headings } = await render(writeup);
const { prev, next } = await getWriteupNeighbors(writeup.data.slug);
---

<WriteupLayout
  title={writeup.data.title}
  description={writeup.data.description}
  protocol={writeup.data.protocol}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</WriteupLayout>

---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import WriteupSidebar from './WriteupSidebar.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface WriteupLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  protocol?: string;
  headings?: Heading[];
  prev?: WriteupLink;
  next?: WriteupLink;
}

const { title, description, protocol, headings = [], prev, next } = Astro.props;
---

<Layout title={`${title} | Pawan R`} description={description}>
  <div class="writeup-page">
    <Navbar activePage="writeups" />

    <div class="writeup-shell">
      <WriteupSidebar current={protocol} headings={headings} />

      <main class="writeup-main" id="main-content">
        <article class="writeup-article">
          <header class="article-header">
            <p class="article-label">{title.toUpperCase()}</p>

            <h1>{title}</h1>

            {description && <p class="article-description">{description}</p>}
          </header>

          <div class="article-content">
            <slot />
          </div>

          {(prev || next) && (
            <nav class="article-pager" aria-label="Write-up navigation">
              {prev && (
                <a class="pager-link pager-prev" href={prev.href}>
                  <span class="pager-label"><span aria-hidden="true">←</span> Previous</span>
                  <span class="pager-title">{prev.title}</span>
                </a>
              )}

              {next && (
                <a class="pager-link pager-next" href={next.href}>
                  <span class="pager-label">Next <span aria-hidden="true">→</span></span>
                  <span class="pager-title">{next.title}</span>
                </a>
              )}
            </nav>
          )}
        </article>
      </main>
    </div>
  </div>

</Layout>

<style is:global>
  .writeup-page {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
  }

  .writeup-shell {
    display: flex;
    width: 100%;
    min-height: 100vh;
    background: var(--bg);
  }

  .writeup-main {
    flex: 1;
    min-width: 0;
    background: var(--bg);
  }

  .writeup-article {
    width: min(100%, 900px);
    margin: 0 auto;
    padding: 120px 48px 120px;
    box-sizing: border-box;
    font-family: var(--font-serif);
  }

  /* =========================
     ARTICLE
     ========================= */

  .article-header {
    padding-bottom: 48px;
    border-bottom: 1px solid var(--line);
  }

  .article-label {
    margin: 0 0 18px;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  .article-header h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .article-description {
    max-width: var(--measure);
    margin: 24px 0 0;
    color: var(--text-secondary);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .article-content {
    padding-top: 48px;
    color: var(--text-body);
    font-size: 1.15rem;
    line-height: 1.85;
    overflow-wrap: break-word;
  }

  .article-content h1,
  .article-content h2,
  .article-content h3 {
    color: var(--text);
    line-height: 1.25;
    letter-spacing: -0.01em;
    scroll-margin-top: 28px;
  }

  .article-content h1 {
    margin: 60px 0 22px;
    font-size: 1.95rem;
  }

  .article-content h2 {
    margin: 48px 0 18px;
    font-size: 1.5rem;
  }

  .article-content h3 {
    margin: 36px 0 14px;
    font-size: 1.2rem;
  }

  .article-content p {
    margin: 0 0 22px;
    max-width: var(--measure);
  }

  .article-content strong {
    color: var(--text);
  }

  .article-content a {
    color: var(--accent);
  }

  .article-content ul,
  .article-content ol {
    margin: 0 0 26px;
    padding-left: 24px;
    max-width: var(--measure);
  }

  .article-content ul {
    list-style: none;
    padding-left: 24px;
  }

  .article-content ul li::before {
    content: "•";
    margin-right: 12px;
    color: var(--text-muted);
  }

  .article-content li {
    margin-bottom: 8px;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .article-content pre {
    margin: 26px 0;
    padding: 18px;
    overflow-x: auto;
    background: var(--bg-inset);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .article-content code {
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }

  .article-content :not(pre) > code {
    padding: 3px 6px;
    color: var(--code-text);
    background: var(--code-bg);
    border-radius: 4px;
  }

  .article-content blockquote {
    margin: 26px 0;
    padding: 4px 0 4px 18px;
    color: var(--text-secondary);
    border-left: 2px solid var(--accent);
    max-width: var(--measure);
  }

  .article-content img {
    display: block;
    width: 100%;
    height: auto;
    margin: 26px 0 36px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-inset);
  }

  .article-content table {
    width: 100%;
    margin: 30px 0 36px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .article-content th,
  .article-content td {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--line);
  }

  .article-content th:first-child,
  .article-content td:first-child {
    width: 1%;
    white-space: nowrap;
  }

  .article-content th {
    color: var(--text);
    background: var(--bg-inset);
    font-weight: 700;
  }

  .article-content td {
    color: var(--text-body);
    background: var(--bg-code);
  }

  /* =========================
     PREVIOUS / NEXT
     ========================= */

  .article-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 44px;
    padding: 16px 18px;
    color: inherit;
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .pager-next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .pager-label {
    font-family: var(--font-sans);
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pager-title {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.4;
  }

  .pager-link:hover {
    background: var(--bg-elevated);
    border-color: var(--accent-line);
  }

  .pager-link:hover .pager-title {
    color: var(--accent);
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 900px) {
    .writeup-article {
      padding: 104px 28px 96px;
    }

  }

  @media (max-width: 359px) {
    .writeup-article {
      padding-top: 128px;
    }
  }

  @media (max-width: 600px) {
    .writeup-article {
      padding: 100px 20px 80px;
    }

    .article-header h1 {
      font-size: clamp(1.85rem, 7.6vw, 2.5rem);
      overflow-wrap: anywhere;
    }

    .article-description {
      font-size: 1rem;
    }

    .article-content {
      font-size: 1.08rem;
      line-height: 1.8;
    }

    .article-content li {
      font-size: 1.08rem;
      line-height: 1.75;
    }

    .article-content pre {
      padding: 14px;
    }

    .article-content table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }

    .article-pager {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 48px;
    }

    .pager-next {
      grid-column: 1;
      align-items: flex-start;
      text-align: left;
    }
  }
</style>

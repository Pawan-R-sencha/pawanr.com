---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
  <Navbar flow="static" activePage="home" />

  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="greeting">Namaste <span>🙏</span></p>

        <h1>
          <span class="headline-first">Offensive Security |</span>
          Curious Mind
          <span class="tagline">Learning, Building, Explaining How Things Work</span>
        </h1>

        <p class="hero-description">
          I'm Pawan R — a cybersecurity graduate who's more curious
          about the <strong>"why"</strong> behind an attack path
          than just finding it.
        </p>

        <p class="hero-description">
          I work across web applications, APIs, networks, and cloud
          environments, while continuing to deepen my skills in
          offensive security.
        </p>

      </div>

      <div class="hero-photo">
        <div class="photo-frame">
          <img
            src="/images/pawan-photo-1280.jpg"
            srcset="/images/pawan-photo-640.jpg 640w, /images/pawan-photo-960.jpg 960w, /images/pawan-photo-1280.jpg 1280w"
            sizes="(max-width: 800px) 92vw, 360px"
            width="1280"
            height="1706"
            alt="Pawan R - Offensive Security Professional"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="hero-buttons">
        <a href="/journey/" class="button primary">My Journey</a>
        <a href="/writeups/" class="button secondary">View Write-ups</a>
      </div>
    </section>

    <section class="focus">
      <h2 class="section-label">WHAT I WORK WITH</h2>

      <div class="focus-grid">
        <div>Web Application Security</div>
        <div>API Security</div>
        <div>Network Security</div>
        <div>Cloud Security Assessment (AWS/GCP)</div>
        <div>Vulnerability Assessment & Penetration Testing</div>
        <div>Phishing / Social Engineering</div>
        <div>Security Automation</div>
      </div>
    </section>

    <section class="highlights">
      <h2 class="section-label">MILESTONES & CERTIFICATIONS</h2>

      <div class="highlight-pills">
        <span class="pill gold-accent">🏆 B.Sc. Cyber Security Gold Medalist Graduate</span>
        <span class="pill award-accent">⭐ Best Newbie Award</span>
        <span class="pill">TryHackMe Top 2%</span>
        <span class="pill">eJPT</span>
        <span class="pill">eWPT</span>
        <span class="pill">ICCA</span>
      </div>
    </section>

    <section class="split-row">
      <div class="split-card">
        <h2 class="section-label">CURRENTLY LEARNING</h2>
        <p class="split-text">
          Active Directory & Windows Security, and going deeper
          into offensive security fundamentals.
        </p>
      </div>

      <div class="split-card">
        <h2 class="section-label">MENTORING</h2>
        <p class="split-text">
          I train and mentor aspiring security professionals
          from the ground up.
        </p>
      </div>
    </section>

    <section class="closing-cta">
      <p>Want the full story — certifications, my graduation, and how I got here?</p>
      <a href="/journey/" class="button primary">Read My Journey</a>
    </section>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
  }

  .hero {
    max-width: 1200px;
    min-height: 72vh;
    margin: 0 auto;
    padding: 112px 40px 64px;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    grid-template-areas:
      "intro photo"
      "actions photo";
    align-content: center;
    align-items: center;
    column-gap: 70px;
    row-gap: 0;
  }

  .hero-content {
    grid-area: intro;
  }

  .hero-photo {
    grid-area: photo;
  }

  .hero-buttons {
    grid-area: actions;
  }

  .greeting {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0 0 24px;
    background: rgba(77, 166, 255, 0.08);
    border: 1px solid rgba(77, 166, 255, 0.2);
    padding: 6px 16px;
    border-radius: 999px;
    width: fit-content;
  }

  .greeting span {
    display: inline-block;
    font-size: 1.4rem;
  }

  h1 {
    font-size: var(--fs-hero);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0 0 30px;
    max-width: 800px;
  }

  .headline-first {
    white-space: nowrap;
    display: inline-block;
    color: var(--accent);
    margin-right: 0.15em;
  }

  h1 .tagline {
    display: block;
    color: var(--text-secondary);
    font-size: max(1rem, 0.3em);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
    margin-top: 18px;
    max-width: 34ch;
  }

  .hero-description {
    max-width: var(--measure-narrow);
    color: var(--text-secondary);
    font-size: var(--fs-body);
    line-height: 1.7;
    margin: 0 0 14px;
  }

  .hero-description strong {
    color: var(--text);
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 32px;
  }

  .button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .primary {
    background: var(--accent-strong);
    color: #ffffff;
  }

  .primary:hover {
    background: var(--accent-strong-hover);
  }

  .secondary {
    border: 1px solid var(--line-strong);
    color: var(--text);
  }

  .secondary:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .hero-photo {
    display: flex;
    justify-content: center;
  }

  .photo-frame {
    width: min(360px, 100%);
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    padding: 8px;
    background: var(--bg-elevated);
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 12px;
  }

  .focus,
  .highlights,
  .split-row,
  .closing-cta {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 40px;
  }

  .section-label {
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.4;
    margin: 0 0 20px;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .focus-grid div {
    border: 1px solid var(--line-strong);
    background: var(--bg-elevated);
    border-radius: 10px;
    padding: 20px;
    color: var(--text-on-card);
  }

  .highlight-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    border: 1px solid var(--line-strong);
    background: var(--bg-chip);
    color: var(--text-on-card);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .pill.gold-accent {
    border-color: var(--gold-border);
    background: var(--gold-bg);
    color: var(--gold-text);
  }

  .pill.award-accent {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--award-text);
  }

  .split-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .split-card {
    border: 1px solid var(--line-strong);
    background: var(--bg-elevated);
    border-radius: var(--radius);
    padding: 24px;
  }

  .split-text {
    color: var(--text-on-card);
    line-height: 1.7;
    margin: 0;
    max-width: var(--measure-narrow);
  }

  .closing-cta {
    text-align: center;
    padding: 60px 40px 100px;
  }

  .closing-cta p {
    color: var(--text-secondary);
    font-size: 1.15rem;
    margin: 0 0 24px;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "photo"
        "actions";
      padding: 100px 24px 48px;
      gap: 32px;
      min-height: auto;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    .split-row {
      grid-template-columns: 1fr;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: stretch;
      margin-top: 0;
    }

    .button {
      width: 100%;
    }

    .focus,
    .highlights,
    .split-row,
    .closing-cta {
      padding: 26px 24px;
    }

    .closing-cta {
      padding: 48px 24px 80px;
    }
  }

  @media (max-width: 359px) {
    .hero {
      padding-top: 128px;
    }
  }

  @media (max-width: 420px) {
    .hero {
      padding-left: 20px;
      padding-right: 20px;
    }

    .focus,
    .highlights,
    .split-row,
    .closing-cta {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
